[gd_resource type="AudioBusLayout" format=3]

; Layout de buses (SPEC secao 6; RB-04). Aplicado por game/project.godot ([audio] buses/default_bus_layout).
; Niveis-alvo APROXIMADOS (nao medidos em LUFS; so RMS/pico dos arquivos em source_audio/report.json):
;   Voz ~ -14 LUFS (arquivos: RMS ~ -19 a -22 dBFS, pico <= -3 dBFS; bus 0 dB)
;   Musica ~ -24 LUFS (bus -4 dB + gain por tema; cai ~4-6 dB pelo sidechain durante a fala)
;   Efeitos ~ -20 LUFS em picos de acao (bus -2 dB + gain_db por efeito em sfx_catalog.json)
;   Ambiente ~ -30 LUFS (bus -8 dB + gain_db por loop)
;   Master: limitador com teto -1 dB (picos <= -1 dBTP; teto em amostra, estimativa nao certificada).
; Musica: (1) compressor com SIDECHAIN na Voz (limiar -28 dB, 3:1, ataque 40 ms, liberacao 600 ms) = ducking suave;
;   (2) EQ6 para abrir espaco a voz: -6 dB em 32 Hz, -2 dB em 320 Hz, -3 dB em 1 kHz, -3 dB em 3,2 kHz (presenca),
;   -2 dB em 10 kHz. Ducking manual extra: AudioDirector.duck_music(true) (-6 dB, 0,3 s; volta em 0,8 s).
; Voz: passa-altas 90 Hz. Ambiente: passa-baixas opcional (desligado; AudioDirector.set_ambience_lowpass).
; Valores provisorios; mixagem fina e aceite perceptual pendentes (Thiago).
[sub_resource type="AudioEffectHardLimiter" id="limiter"]
ceiling_db = -1.0
pre_gain_db = 0.0
release = 0.1

[sub_resource type="AudioEffectHighPassFilter" id="voice_hp"]
cutoff_hz = 90.0

[sub_resource type="AudioEffectCompressor" id="duck"]
threshold = -28.0
ratio = 3.0
gain = 0.0
attack_us = 40000.0
release_ms = 600.0
mix = 1.0
sidechain = &"Voz"

[sub_resource type="AudioEffectEQ6" id="music_eq"]
band_db/0 = -6.0
band_db/1 = -2.0
band_db/2 = -3.0
band_db/3 = -3.0
band_db/4 = -2.0
band_db/5 = 0.0

[sub_resource type="AudioEffectLowPassFilter" id="amb_lp"]
cutoff_hz = 5000.0

[resource]
bus/0/name = &"Master"
bus/0/solo = false
bus/0/mute = false
bus/0/bypass_fx = false
bus/0/volume_db = 0.0
bus/0/send = &""
bus/0/effect/0/effect = SubResource("limiter")
bus/0/effect/0/enabled = true
bus/1/name = &"Voz"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/1/effect/0/effect = SubResource("voice_hp")
bus/1/effect/0/enabled = true
bus/2/name = &"Musica"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = -4.0
bus/2/send = &"Master"
bus/2/effect/0/effect = SubResource("duck")
bus/2/effect/0/enabled = true
bus/2/effect/1/effect = SubResource("music_eq")
bus/2/effect/1/enabled = true
bus/3/name = &"Efeitos"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = -2.0
bus/3/send = &"Master"
bus/4/name = &"Ambiente"
bus/4/solo = false
bus/4/mute = false
bus/4/bypass_fx = false
bus/4/volume_db = -8.0
bus/4/send = &"Master"
bus/4/effect/0/effect = SubResource("amb_lp")
bus/4/effect/0/enabled = false
